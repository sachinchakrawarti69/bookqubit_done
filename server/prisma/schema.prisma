generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Language {
  language_id   Int                @id @map("language_id")
  code          String             @unique @db.VarChar(10)
  english_name  String             @db.VarChar(100)
  native_name   String             @db.VarChar(100)
  is_rtl        Boolean            @default(false)
  books         Book[]
  translations  BookTranslation[]
  bookLanguages BookLanguage[]
  categoryTrans CategoryTranslation[]

  @@map("languages")
}

model Author {
  author_id    BigInt    @id @default(autoincrement()) @map("author_id")
  author_name  String    @db.VarChar(255)
  bio          String?   @db.Text
  birth_date   DateTime? @db.Date
  nationality  String?   @db.VarChar(100)
  created_at   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at   DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  books        Book[]

  @@map("authors")
}

model Publisher {
  publisher_id   BigInt   @id @default(autoincrement()) @map("publisher_id")
  publisher_name String   @db.VarChar(255)
  website        String?  @db.VarChar(255)
  created_at     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  books          Book[]

  @@map("publishers")
}

model Book {
  book_id               BigInt    @id @default(autoincrement()) @map("book_id")
  title                 String    @db.VarChar(500)
  subtitle              String?   @db.VarChar(500)
  slug                  String?   @unique @db.VarChar(500)
  author_id             BigInt    @map("author_id")
  publisher_id          BigInt?   @map("publisher_id")
  original_language_id  Int       @map("original_language_id")
  publication_year      Int?
  publication_date      DateTime? @db.Date
  edition               String?   @db.VarChar(100)
  isbn_10               String?   @db.VarChar(20)
  isbn_13               String?   @db.VarChar(20)
  summary               String?   @db.Text
  key_highlights        String?   @db.Text
  table_of_contents     String?   @db.Text
  page_count            Int?
  cover_image_url       String?   @db.VarChar(500)
  average_rating        Decimal?  @db.Decimal(3, 2)
  review_count          Int?
  meta_title            String?   @db.VarChar(255)
  meta_description      String?   @db.Text
  created_at            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  author                Author    @relation(fields: [author_id], references: [author_id])
  publisher             Publisher? @relation(fields: [publisher_id], references: [publisher_id])
  originalLanguage      Language  @relation(fields: [original_language_id], references: [language_id])
  translations          BookTranslation[]
  publicationDetails    BookPublicationDetail[]
  languages             BookLanguage[]
  categories            BookCategory[]

  @@index([author_id])
  @@index([publisher_id])
  @@index([original_language_id])
  @@map("books")
}

model BookTranslation {
  translation_id   BigInt    @id @default(autoincrement()) @map("translation_id")
  book_id          BigInt    @map("book_id")
  language_id      Int       @map("language_id")
  title            String    @db.VarChar(500)
  subtitle         String?   @db.VarChar(500)
  slug             String    @unique @db.VarChar(500)
  summary          String?   @db.Text
  key_highlights   String?   @db.Text
  subjects_covered String?   @db.Text
  seo_title        String?   @db.VarChar(255)
  seo_description  String?   @db.Text
  seo_keywords     String?   @db.Text
  created_at       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  book             Book      @relation(fields: [book_id], references: [book_id])
  language         Language  @relation(fields: [language_id], references: [language_id])

  @@unique([book_id, language_id])
  @@map("book_translations")
}

model BookPublicationDetail {
  publication_id   BigInt    @id @default(autoincrement()) @map("publication_id")
  book_id          BigInt    @map("book_id")
  isbn_10          String?   @db.VarChar(20)
  isbn_13          String?   @db.VarChar(20)
  edition          String?   @db.VarChar(100)
  publication_date DateTime? @db.Date
  pages            Int?
  format           String?   @db.VarChar(50)
  created_at       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  book             Book      @relation(fields: [book_id], references: [book_id])

  @@map("book_publication_details")
}

model BookLanguage {
  id          BigInt   @id @default(autoincrement())
  book_id     BigInt   @map("book_id")
  language_id Int      @map("language_id")

  book        Book     @relation(fields: [book_id], references: [book_id])
  language    Language @relation(fields: [language_id], references: [language_id])

  @@unique([book_id, language_id])
  @@map("book_languages")
}

model Category {
  category_id  BigInt   @id @default(autoincrement()) @map("category_id")
  slug         String?  @unique @db.VarChar(255)
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  translations CategoryTranslation[]
  books        BookCategory[]

  @@map("categories")
}

model CategoryTranslation {
  id           BigInt   @id @default(autoincrement())
  category_id  BigInt   @map("category_id")
  language_id  Int      @map("language_id")
  name         String   @db.VarChar(255)
  description  String?  @db.Text

  category     Category @relation(fields: [category_id], references: [category_id])
  language     Language @relation(fields: [language_id], references: [language_id])

  @@unique([category_id, language_id])
  @@map("category_translations")
}

model BookCategory {
  book_id     BigInt @map("book_id")
  category_id BigInt @map("category_id")

  book        Book     @relation(fields: [book_id], references: [book_id])
  category    Category @relation(fields: [category_id], references: [category_id])

  @@id([book_id, category_id])
  @@map("book_categories")
}